{
  "name": "openclaw-telegram-proxy",
  "version": "1.0.1",
  "description": "OpenClaw plugin to replace api.telegram.org with custom proxy for Telegram access in restricted regions",
  "type": "module",
  "main": "index.ts",
  "keywords": [
    "openclaw",
    "telegram",
    "proxy",
    "telegram-api",
    "china",
    "vpn",
    "reverse-proxy"
  ],
  "author": "hillghost",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hillghost86/openclaw-telegram-proxy.git"
  },
  "bugs": {
    "url": "https://github.com/hillghost86/openclaw-telegram-proxy/issues"
  },
  "homepage": "https://github.com/hillghost86/openclaw-telegram-proxy#readme",
  "scripts": {
    "postinstall": "bash install.sh",
    "postuninstall": "bash uninstall.sh"
  },
  "files": [
    "index.ts",
    "openclaw.plugin.json",
    "cloudflare/worker.js",
    "install.sh",
    "uninstall.sh",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "openclaw": ">=1.0.0"
  },
  "devDependencies": {
    "openclaw": ">=1.0.0"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ]
  }
}
